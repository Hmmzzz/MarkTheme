#!/bin/sh

set -e

package_prefix='@MARKTHEME_PACKAGE_PREFIX@'
runtime_helper="${package_prefix}/usr/libexec/marktheme-helper"

case "${1:-}" in
  remove)
    # The Helper is still present during prerm. Move every loaded Runtime to
    # the canonical disabled snapshot before dpkg removes the payload. A
    # failed or already-unavailable Helper must never make uninstall stick.
    if [ -f "$runtime_helper" ] && [ ! -L "$runtime_helper" ] &&
       [ -x "$runtime_helper" ]; then
      "$runtime_helper" disable --json >/dev/null 2>&1 || true
    fi
    ;;
  upgrade|failed-upgrade|deconfigure)
    ;;
esac

exit 0
