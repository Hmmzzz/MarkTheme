    'probes/runtime-(feasibility|reader|store-durability|abi-inspector|adapter-inspector|visual-inspector|invalidation-emitter)|MarkThemeRuntimeProbe|marktheme-runtime-(store-durability|abi-inspector|adapter-inspector|visual-inspector|invalidation-emitter)|com\.hmmzzz\.marktheme\.(runtimeprobe|runtimereaderprobe|runtimestoredurabilityprobe)' \
    "$marktheme_root/Makefile" \
    "$marktheme_root/control" \
    "$marktheme_root/scripts"; then
  printf 'FAIL: an internal runtime probe escaped into the product build or verifier.\n' >&2
  exit 1
fi

if rg -n \
    'MTSyntheticCorpus|tests/benchmark|tests/run-benchmarks' \
    "$marktheme_root/app/Makefile" \
    "$marktheme_root/control" \
    "$marktheme_root/scripts"; then
  printf 'FAIL: host benchmark instrumentation escaped into the product build.\n' >&2
  exit 1
fi

if ! rg -q '^Depends: .*ellekit \(>= 1\.2\)' "$marktheme_root/control"; then
  printf 'FAIL: the product Runtime package does not require ElleKit 1.2.\n' >&2
  exit 1
fi
if rg -n -i '(^|[,( ])mobilesubstrate([ ),]|$)' "$marktheme_root/control"; then
  printf 'FAIL: the product control metadata contains an undeclared injection backend.\n' >&2
  exit 1
fi

if rg -n \
    '^#import[[:space:]]+"MTGenerationWriter|MTCompiledGeneration[[:space:]]*\*|MTGenerationWriterValidate|MTGenerationWriterVerify' \
    "$marktheme_root/compiler/MTGenerationReader.h" \
    "$marktheme_root/compiler/MTGenerationReader.m" \
    "$marktheme_root/compiler/MTGenerationReaderFilesystem.h" \
    "$marktheme_root/compiler/MTGenerationReaderFilesystem.m" \
    "$marktheme_root/compiler/MTGenerationReaderValidation.h" \
    "$marktheme_root/compiler/MTGenerationReaderValidation.m"; then
  printf 'FAIL: Generation Reader source depends on a writer-owned implementation.\n' >&2
  exit 1
fi


if rg -n '/private/preboot/|/var/jb' \
    "$marktheme_root/app" \
    "$marktheme_root/core" \
    "$marktheme_root/compiler" \
    "$marktheme_root/helper" \
    "$marktheme_root/ingestion" \
    "$marktheme_root/importers" \
    "$marktheme_root/library" \
    "$marktheme_root/workflow" \
    "$marktheme_root/modules" \
    "$marktheme_root/platform" \
    "$marktheme_root/runtime" \
    "$marktheme_root/store" \
    -g '*.{h,m,mm,c,cpp,plist,strings}'; then
  printf 'FAIL: a physical bootstrap path escaped into product source.\n' >&2
  exit 1
fi

icon_service_dir="$marktheme_root/iconservice"
icon_service_makefile="$icon_service_dir/Makefile"
icon_service_filter="$icon_service_dir/MarkThemeIconServiceRuntime.plist"
if ! rg -F -x -q 'MARKTHEME_ICON_SERVICE_RUNTIME_MODE ?= 2' \
      "$icon_service_makefile" || \
   ! rg -F -x -q 'MARKTHEME_ICON_SERVICE_STORE_CONTROL ?= 1' \
      "$icon_service_makefile" || \
   ! rg -F -x -q 'MARKTHEME_ICON_SERVICE_BARRIER_REQUIRED ?= 1' \
      "$marktheme_root/helper/Makefile" || \
   [[ $(plutil -extract Filter.Executables json -o - \
      "$icon_service_filter") != '["iconservicesagent"]' ]] || \
   ! rg -F -x -q 'SUBPROJECTS += iconservice' "$marktheme_root/Makefile" || \
   [[ -e "$icon_service_dir/control" ]]; then
  printf 'FAIL: the official IconServices source, exact filter, service barrier, or aggregate packaging contract is missing.\n' >&2
  exit 1
fi
if rg -n \
    'UIKit|QuartzCore|SpringBoardHome|SearchUI|PreferencesApplicationIcon|ShareSheetActivityImage' \
    "$icon_service_makefile" \
    "$icon_service_dir" -g '*.{h,m,mm,c,cpp}'; then
  printf 'FAIL: a display-process or UIKit dependency escaped into the IconServices service runtime.\n' >&2
  exit 1
fi
for icon_service_contract in \
  'generateImageReturningRecordIdentifiers:' \
  '@24@0:8^@16' \
  'initWithServiceName:' \
  '@24@0:8@16' \
  'initWithCGImage:scale:minimumSize:placeholder:iconSize:' \
  'initWithData:uuid:validationToken:' \
  'MTIconServiceMethodCache' \
  'MTValidatedCacheImageInitializer' \
  'MTValidatedImageDataInitializer' \
  'ClearCacheOperation' \
  'scheduleCacheOperation:' \
  'MTWholeCacheOperationType = 2' \
  'native-whole-cache-cleared' \
  'native-clear-completion-timeout' \
  'MTRuntimePublishedImageResizePolicyBoundedScaleToFill' \
  'MTIconMaskCreateImage' \
  'MTIconOverlayCreateImage'; do
  rg -F -q "$icon_service_contract" "$icon_service_dir" \
      -g '*.{h,m,mm,c,cpp}' || {
    printf 'FAIL: IconServices runtime omits proven contract: %s\n' \
      "$icon_service_contract" >&2
    exit 1
  }
done
if rg -F -q 'generateStoreUnitWithRequest:validationToken:' \
      "$icon_service_dir" -g '*.{h,m,mm,c,cpp}'; then
  printf 'FAIL: a per-StoreUnit service Hook escaped into the IconServices control plane.\n' >&2
  exit 1
fi
if [[ $(rg -F -c 'MSHookMessageEx(' \
      "$icon_service_dir/MTIconServiceGenerationAdapter.m") -ne 1 ]]; then
  printf 'FAIL: IconServices source runtime must contain exactly one pixel-generation Hook installation.\n' >&2
  exit 1
fi
if rg -n 'MTIconServiceStoreIndex|performBlock:|enumerateValuesForUUID|removeValueForUUID|recordGeneratedContext|invalidateBundleIdentifiers:' \
      "$icon_service_dir" -g '*.{h,m,mm,c,cpp}'; then
  printf 'FAIL: obsolete targeted StoreIndex tracking or mutation escaped into the IconServices source.\n' >&2
  exit 1
fi

for retired_source in \
  runtime/MTRuntimeAsyncObjectCache.h \
  runtime/MTRuntimeAsyncObjectCache.m \
  runtime/MTRuntimeFeatureState.h \
  runtime/MTRuntimeFeatureState.m \
  iconservice/MTIconServiceProvenCanary.h \
  iconservice/MTIconServiceProvenCanary.m \
  iconservice/MTIconServiceSourcePolicy.h \
  iconservice/MTIconServiceSourcePolicy.m; do
  if [[ -e "$marktheme_root/$retired_source" ]]; then
    printf 'FAIL: retired defensive component returned: %s\n' \
      "$retired_source" >&2
    exit 1
  fi
done

printf 'PASS: MarkTheme service-source cache lifecycle, immutable display snapshots, durability, Apply, Store, Helper, generation and resource boundaries\n'
