#!/usr/bin/env bash

set -euo pipefail

test_script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
marktheme_root=$(CDPATH= cd -- "$test_script_dir/.." && pwd)
workspace_root=$(CDPATH= cd -- "$marktheme_root/../.." && pwd)

if [[ ${MARKTHEME_LOCAL_TEST_ENV_READY:-0} != 1 ]]; then
  export MARKTHEME_LOCAL_TEST_ENV_READY=1
  exec "$workspace_root/scripts/jb-env" "$0" "$@"
fi

emit_simulator_fixtures=0
emit_runtime_fixture=0
emit_runtime_stress_fixture=0
emit_runtime_snapshot_fixture=0
emit_runtime_swap_fixture=0
emit_runtime_fallback_fixture=0
emit_runtime_performance_fixture=0
emit_real_theme_runtime_fixture=0
emit_share_sheet_runtime_fixture=0
inspect_theme_zip=0
runtime_fixture_output=''
theme_zip_input=''
if [[ $# -eq 1 && $1 == --emit-simulator-fixtures ]]; then
  emit_simulator_fixtures=1
elif [[ $# -eq 2 && $1 == --emit-runtime-fixture ]]; then
  emit_runtime_fixture=1
  runtime_fixture_output=$2
  if [[ $runtime_fixture_output != /* ]]; then
    printf 'Runtime fixture output must be an absolute path.\n' >&2
    exit 64
  fi
elif [[ $# -eq 2 && $1 == --emit-runtime-stress-fixture ]]; then
  emit_runtime_stress_fixture=1
  runtime_fixture_output=$2
  if [[ $runtime_fixture_output != /* ]]; then
    printf 'Runtime stress fixture output must be an absolute path.\n' >&2
    exit 64
  fi
elif [[ $# -eq 2 && $1 == --emit-runtime-snapshot-fixture ]]; then
  emit_runtime_snapshot_fixture=1
  runtime_fixture_output=$2
  if [[ $runtime_fixture_output != /* ]]; then
    printf 'Runtime snapshot fixture output must be an absolute path.\n' >&2
    exit 64
  fi
elif [[ $# -eq 2 && $1 == --emit-runtime-swap-fixture ]]; then
  emit_runtime_swap_fixture=1
  runtime_fixture_output=$2
  if [[ $runtime_fixture_output != /* ]]; then
    printf 'Runtime swap fixture output must be an absolute path.\n' >&2
    exit 64
  fi
elif [[ $# -eq 2 && $1 == --emit-runtime-fallback-fixture ]]; then
  emit_runtime_fallback_fixture=1
  runtime_fixture_output=$2
  if [[ $runtime_fixture_output != /* ]]; then
    printf 'Runtime fallback fixture output must be an absolute path.\n' >&2
    exit 64
  fi
elif [[ $# -eq 2 && $1 == --emit-runtime-performance-fixture ]]; then
  emit_runtime_performance_fixture=1
  runtime_fixture_output=$2
  if [[ $runtime_fixture_output != /* ]]; then
    printf 'Runtime performance fixture output must be an absolute path.\n' >&2
    exit 64
  fi
elif [[ $# -eq 2 && $1 == --inspect-theme-zip ]]; then
  inspect_theme_zip=1
  theme_zip_input=$2
  if [[ $theme_zip_input != /* || ! -f $theme_zip_input ]]; then
    printf 'Theme ZIP input must be an absolute regular-file path.\n' >&2
    exit 64
  fi
elif [[ $# -eq 3 && $1 == --emit-real-theme-runtime-fixture ]]; then
  emit_real_theme_runtime_fixture=1
  theme_zip_input=$2
  runtime_fixture_output=$3
  if [[ $theme_zip_input != /* || ! -f $theme_zip_input || \
        $runtime_fixture_output != /* ]]; then
    printf 'Real-theme Runtime fixture paths must be absolute and the ZIP must be a regular file.\n' >&2
    exit 64
  fi
elif [[ $# -eq 3 && $1 == --emit-share-sheet-runtime-fixture ]]; then
  emit_share_sheet_runtime_fixture=1
  theme_zip_input=$2
  runtime_fixture_output=$3
  if [[ $theme_zip_input != /* || -e $theme_zip_input || \
        $runtime_fixture_output != /* || -e $runtime_fixture_output ]]; then
    printf 'Share Runtime fixture outputs must be absent absolute paths.\n' >&2
    exit 64
  fi
elif [[ $# -ne 0 ]]; then
  printf 'Usage: %s [--inspect-theme-zip <absolute-zip> | --emit-real-theme-runtime-fixture <absolute-zip> <absolute-directory> | --emit-share-sheet-runtime-fixture <absolute-zip> <absolute-directory> | --emit-simulator-fixtures | --emit-runtime-fixture <absolute-directory> | --emit-runtime-stress-fixture <absolute-directory> | --emit-runtime-snapshot-fixture <absolute-directory> | --emit-runtime-swap-fixture <absolute-directory> | --emit-runtime-fallback-fixture <absolute-directory> | --emit-runtime-performance-fixture <absolute-directory>]\n' "$0" >&2
  exit 64
fi

test_build_dir=$(mktemp -d /tmp/marktheme-foundation-tests.XXXXXX)

cleanup() {
  if [[ "$test_build_dir" == /tmp/marktheme-foundation-tests.* && \
        -d "$test_build_dir" ]]; then
    find "$test_build_dir" -depth -delete
  fi
}
trap cleanup EXIT INT TERM

core_sources=(
  "$marktheme_root/runtime/MTRuntimeDiagnosticsProtocol.m"
  "$marktheme_root/core/MTIdentifier.m"
  "$marktheme_root/core/MTImportLimits.m"
  "$marktheme_root/core/MTVersionContracts.m"
  "$marktheme_root/core/MTCanonicalJSON.m"
  "$marktheme_root/core/MTDigest.m"
  "$marktheme_root/core/MTResourceKey.m"
  "$marktheme_root/core/MTSourceInventory.m"
  "$marktheme_root/core/MTThemeManifest.m"
  "$marktheme_root/core/MTDiagnostic.m"
  "$marktheme_root/core/MTLayerResolver.m"
  "$marktheme_root/core/MTModuleConfiguration.m"
)
module_sources=(
  "$marktheme_root/modules/MTModuleDescriptor.m"
  "$marktheme_root/modules/MTModuleRegistry.m"
  "$marktheme_root/modules/MTStaticIconsModule.m"
  "$marktheme_root/modules/MTStaticIconConfiguration.m"
  "$marktheme_root/modules/MTBadgeContract.m"
  "$marktheme_root/modules/MTBadgeConfiguration.m"
  "$marktheme_root/modules/MTBadgesModule.m"
  "$marktheme_root/modules/MTCalendarIconConfiguration.m"
  "$marktheme_root/modules/MTCalendarIconsModule.m"
  "$marktheme_root/modules/MTClockIconContract.m"
  "$marktheme_root/modules/MTClockIconsModule.m"
  "$marktheme_root/modules/MTDialerContract.m"
  "$marktheme_root/modules/MTDialerModule.m"
  "$marktheme_root/modules/MTFolderIconContract.m"
  "$marktheme_root/modules/MTFolderIconsModule.m"
  "$marktheme_root/modules/MTIconMaskConfiguration.m"
  "$marktheme_root/modules/MTIconMaskContract.m"
  "$marktheme_root/modules/MTIconMaskModule.m"
  "$marktheme_root/modules/MTIconOverlayContract.m"
  "$marktheme_root/modules/MTIconOverlayModule.m"
  "$marktheme_root/modules/MTIconShadowConfiguration.m"
  "$marktheme_root/modules/MTIconShadowContract.m"
  "$marktheme_root/modules/MTIconShadowsModule.m"
  "$marktheme_root/modules/MTThemeComponentCatalog.m"
  "$marktheme_root/modules/MTThemeMixSelection.m"
  "$marktheme_root/modules/MTStatusBarContract.m"
  "$marktheme_root/modules/MTStatusBarModule.m"
  "$marktheme_root/modules/MTUIResourcesModule.m"
)
compiler_sources=(
  "$marktheme_root/compiler/MTGenerationDescriptor.m"
  "$marktheme_root/compiler/MTGenerationAssetWriter.m"
  "$marktheme_root/compiler/MTGenerationFilesystem.m"
  "$marktheme_root/compiler/MTGenerationIndexCodec.m"
  "$marktheme_root/compiler/MTGenerationReader.m"
  "$marktheme_root/compiler/MTGenerationReaderFilesystem.m"
  "$marktheme_root/compiler/MTGenerationReaderValidation.m"
  "$marktheme_root/compiler/MTGenerationRecovery.m"
  "$marktheme_root/compiler/MTStaticIconCompiler.m"
  "$marktheme_root/compiler/MTGenerationWriter.m"
  "$marktheme_root/compiler/MTGenerationWriterValidation.m"
)
ingestion_sources=(
  "$marktheme_root/ingestion/MTDirectorySnapshotFilesystem.m"
  "$marktheme_root/ingestion/MTDirectorySnapshotSession.m"
  "$marktheme_root/ingestion/MTExpandedArchiveSession.m"
  "$marktheme_root/ingestion/MTImportSession.m"
  "$marktheme_root/ingestion/MTAuditedSource.m"
  "$marktheme_root/ingestion/MTAuditedZIPEntryStreamer.m"
  "$marktheme_root/ingestion/MTSafeImageDecoder.m"
  "$marktheme_root/ingestion/MTSafeImageInspector.m"
  "$marktheme_root/ingestion/MTSafePropertyListReader.m"
  "$marktheme_root/ingestion/MTSafeZIPArchiveReader.m"
)
importer_sources=(
  "$marktheme_root/importers/MTSafeDirectoryScanner.m"
  "$marktheme_root/importers/MTIconBundlesImporter.m"
  "$marktheme_root/importers/MTLegacyThemeResourcesImporter.m"
  "$marktheme_root/importers/MTThemeComponentPath.m"
  "$marktheme_root/importers/MTUIResourcesImporter.m"
  "$marktheme_root/importers/MTThemeInfoMetadataImporter.m"
  "$marktheme_root/importers/MTThemeInfoMetadataMapper.m"
)
library_sources=(
  "$marktheme_root/library/MTAssetStagingFilesystem.m"
  "$marktheme_root/library/MTAssetStagingSession.m"
  "$marktheme_root/library/MTThemeLibraryFilesystem.m"
  "$marktheme_root/library/MTThemeLibraryStore.m"
  "$marktheme_root/library/MTThemeLibraryTransaction.m"
  "$marktheme_root/library/MTThemeLibraryCatalog.m"
)
workflow_sources=(
  "$marktheme_root/workflow/MTThemeImport.m"
  "$marktheme_root/workflow/MTImportDiagnostics.m"
  "$marktheme_root/workflow/MTThemeSourceRoot.m"
  "$marktheme_root/workflow/MTInstalledThemeLocator.m"
  "$marktheme_root/workflow/MTThemeCapabilityReport.m"
  "$marktheme_root/workflow/MTImportCoordinator.m"
  "$marktheme_root/workflow/MTThemeApplyService.m"
  "$marktheme_root/workflow/MTThemeComponentSelectionStore.m"
)
store_sources=(
  "$marktheme_root/store/MTRuntimeState.m"
  "$marktheme_root/store/MTRuntimeStoreController.m"
  "$marktheme_root/store/MTRuntimeHelperClient.m"
)
runtime_sources=(
  "$marktheme_root/iconservice/MTIconServiceABI.m"
  "$marktheme_root/iconservice/MTIconServiceImageResolver.m"
  "$marktheme_root/iconservice/MTIconServiceRuntimeMode.m"
  "$marktheme_root/runtime/MTRuntimeInvalidation.m"
  "$marktheme_root/runtime/MTApplicationIconSourceState.m"
  "$marktheme_root/runtime/MTRuntimeKernel.m"
  "$marktheme_root/runtime/MTRuntimeProfile.m"
  "$marktheme_root/runtime/MTRuntimeProfiles.generated.m"
  "$marktheme_root/runtime/MTRuntimeReplacement.m"
  "$marktheme_root/runtime/MTRuntimeObjectCache.m"
  "$marktheme_root/runtime/MTRuntimePublishedImageLoader.m"
  "$marktheme_root/runtime/MTRuntimeSnapshot.m"
  "$marktheme_root/runtime/MTRuntimeSnapshotLoader.m"
  "$marktheme_root/runtime/adapters/MTShareSheetActivityIdentity.m"
  "$marktheme_root/runtime/adapters/MTRuntimeImageABI.m"
  "$marktheme_root/runtime/modules/MTCalendarIconContent.m"
  "$marktheme_root/runtime/modules/MTCalendarIconSnapshotResolver.m"
  "$marktheme_root/runtime/modules/MTBadgeSnapshotResolver.m"
  "$marktheme_root/runtime/modules/MTDialerSnapshotResolver.m"
  "$marktheme_root/runtime/modules/MTIconMaskCompositor.m"
  "$marktheme_root/runtime/modules/MTSystemIconMaskProvider.m"
  "$marktheme_root/runtime/modules/MTIconShadowSnapshotResolver.m"
  "$marktheme_root/runtime/modules/MTStaticIconVisualProofContract.m"
  "$marktheme_root/runtime/modules/MTStaticIconSnapshotResolver.m"
  "$marktheme_root/runtime/modules/MTStatusBarSnapshotResolver.m"
  "$marktheme_root/runtime/modules/MTSpringBoardDecorationSnapshotResolver.m"
  "$marktheme_root/runtime/modules/MTUIResourceSnapshotResolver.m"
)

compile_variant() {
  local variant=$1
  local scheme_define=$2
  xcrun clang \
    -fobjc-arc \
    -fblocks \
    -O2 \
    -Wall \
    -Wextra \
    -Werror \
    -DMT_HOST_TESTING=1 \
    -DMT_RUNTIME_STORE_FAULT_TESTING=1 \
    -DMARKTHEME_RUNTIME_BUILD_NUMBER=123 \
    "$scheme_define" \
    -lz \
    -framework Foundation \
    -framework CoreGraphics \
    -framework ImageIO \
    -I "$marktheme_root/core" \
    -I "$marktheme_root/compiler" \
    -I "$marktheme_root/ingestion" \
    -I "$marktheme_root/importers" \
    -I "$marktheme_root/iconservice" \
    -I "$marktheme_root/library" \
    -I "$marktheme_root/modules" \
    -I "$marktheme_root/platform" \
    -I "$marktheme_root/runtime" \
    -I "$marktheme_root/store" \
    -I "$marktheme_root/tests/support" \
    -I "$marktheme_root/workflow" \
    "${core_sources[@]}" \
    "${module_sources[@]}" \
    "${compiler_sources[@]}" \
    "${ingestion_sources[@]}" \
    "${importer_sources[@]}" \
    "${library_sources[@]}" \
    "${workflow_sources[@]}" \
    "${store_sources[@]}" \
    "${runtime_sources[@]}" \
    "$marktheme_root/platform/MTBootstrapPaths.m" \
    "$marktheme_root/tests/MTGenerationDescriptorTests.m" \
    "$marktheme_root/tests/MTCalendarRuntimeTests.m" \
    "$marktheme_root/tests/MTGenerationIndexTests.m" \
    "$marktheme_root/tests/MTGenerationReaderTests.m" \
    "$marktheme_root/tests/MTGenerationWriterTests.m" \
    "$marktheme_root/tests/MTIconServiceRuntimeTests.m" \
    "$marktheme_root/tests/MTRuntimeKernelTests.m" \
    "$marktheme_root/tests/MTRuntimeProfileTests.m" \
    "$marktheme_root/tests/MTRuntimeReplacementTests.m" \
    "$marktheme_root/tests/MTRuntimeSnapshotResourceTests.m" \
    "$marktheme_root/tests/MTRuntimeStoreTests.m" \
    "$marktheme_root/tests/MTThemeApplyServiceTests.m" \
    "$marktheme_root/tests/support/MTSyntheticCorpus.m" \
    "$marktheme_root/tests/support/MTRuntimeStressFixture.m" \
    "$marktheme_root/tests/main.m" \
    -o "$test_build_dir/marktheme-foundation-tests-$variant"
}

compile_variant rootless -DTHEOS_PACKAGE_SCHEME_ROOTLESS=1
if [[ $inspect_theme_zip == 1 ]]; then
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --inspect-theme-zip "$theme_zip_input"
  exit 0
fi
if [[ $emit_real_theme_runtime_fixture == 1 ]]; then
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --emit-real-theme-runtime-fixture "$theme_zip_input" \
    "$runtime_fixture_output"
  exit 0
fi
if [[ $emit_share_sheet_runtime_fixture == 1 ]]; then
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --emit-share-sheet-runtime-fixture "$theme_zip_input" \
    "$runtime_fixture_output"
  exit 0
fi
if [[ $emit_simulator_fixtures == 1 ]]; then
  simulator_fixture_root="$marktheme_root/.work/simulator/Fixtures"
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --emit-workflow-zip "$simulator_fixture_root/Workflow.theme.zip"
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --emit-invalid-image-zip "$simulator_fixture_root/Bad-Image.theme.zip"
  exit 0
fi

if [[ $emit_runtime_fixture == 1 ]]; then
  MARKTHEME_RUNTIME_FIXTURE_OUTPUT=$runtime_fixture_output \
    "$test_build_dir/marktheme-foundation-tests-rootless" \
    "$marktheme_root/tests/Fixtures/synthetic-static-icons.json" \
    "$marktheme_root/tests/Fixtures/iconbundles-manifest-v2.sha256"
  exit 0
fi

if [[ $emit_runtime_stress_fixture == 1 ]]; then
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --emit-runtime-stress-fixture "$runtime_fixture_output"
  exit 0
fi

if [[ $emit_runtime_snapshot_fixture == 1 ]]; then
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --emit-runtime-snapshot-fixture "$runtime_fixture_output"
  exit 0
fi

if [[ $emit_runtime_swap_fixture == 1 ]]; then
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --emit-runtime-swap-fixture "$runtime_fixture_output"
  exit 0
fi

if [[ $emit_runtime_fallback_fixture == 1 ]]; then
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --emit-runtime-fallback-fixture "$runtime_fixture_output"
  exit 0
fi

if [[ $emit_runtime_performance_fixture == 1 ]]; then
  "$test_build_dir/marktheme-foundation-tests-rootless" \
    --emit-runtime-performance-fixture "$runtime_fixture_output"
  exit 0
fi

compile_variant roothide -DTHEOS_PACKAGE_SCHEME_ROOTHIDE=1

"$marktheme_root/tests/package-lifecycle-contract"

rootless_output=$("$test_build_dir/marktheme-foundation-tests-rootless" \
  "$marktheme_root/tests/Fixtures/synthetic-static-icons.json" \
  "$marktheme_root/tests/Fixtures/iconbundles-manifest-v2.sha256")
roothide_output=$("$test_build_dir/marktheme-foundation-tests-roothide" \
  "$marktheme_root/tests/Fixtures/synthetic-static-icons.json" \
  "$marktheme_root/tests/Fixtures/iconbundles-manifest-v2.sha256")
if [[ "$rootless_output" != "$roothide_output" ]]; then
  printf 'FAIL: rootless and RootHide host contract variants diverged.\n' >&2
  exit 1
fi
printf '%s\n' "$rootless_output"

plutil -lint "$marktheme_root/app/Resources/Info.plist" >/dev/null
if [[ $(plutil -extract LSSupportsOpeningDocumentsInPlace raw -o - \
        "$marktheme_root/app/Resources/Info.plist") != 'true' || \
      $(plutil -extract UTImportedTypeDeclarations.0.UTTypeIdentifier raw -o - \
        "$marktheme_root/app/Resources/Info.plist") != \
        'com.hmmzzz.marktheme.theme-archive' ]] || \
   [[ $(rg -F -l '@[ UTTypeZIP, themeArchive ]' \
      "$marktheme_root/app/MTImportViewController.m" \
      "$marktheme_root/app/MTThemeLibraryViewController.m" | wc -l | tr -d ' ') \
      != '2' ]] || \
   [[ $(rg -F -l 'initForOpeningContentTypes:contentTypes asCopy:NO' \
      "$marktheme_root/app/MTImportViewController.m" \
      "$marktheme_root/app/MTThemeLibraryViewController.m" | wc -l | tr -d ' ') \
      != '2' ]] || \
   rg -F -q 'UTTypeDirectory' \
      "$marktheme_root/app/MTImportViewController.m" \
      "$marktheme_root/app/MTThemeLibraryViewController.m" || \
   rg -F -q 'public.directory' \
      "$marktheme_root/app/Resources/Info.plist" || \
   ! rg -F -q '@"import.source.installed-action"' \
      "$marktheme_root/app/MTImportViewController.m" || \
   ! rg -F -q '@"import.source.zip-action"' \
      "$marktheme_root/app/MTImportViewController.m" || \
   ! rg -F -q '@"import.source.installed-action"' \
      "$marktheme_root/app/MTThemeLibraryViewController.m" || \
   ! rg -F -q '@"import.source.zip-action"' \
      "$marktheme_root/app/MTThemeLibraryViewController.m" || \
   ! rg -F -q '[self pushImportControllerStartingURL:url]' \
      "$marktheme_root/app/MTThemeLibraryViewController.m" || \
   rg -F -q '[importController beginChoosingThemeSource]' \
      "$marktheme_root/app/MTThemeLibraryViewController.m" || \
   ! rg -F -q '[sourceURL startAccessingSecurityScopedResource]' \
      "$marktheme_root/workflow/MTImportCoordinator.m"; then
  printf 'FAIL: iOS document-picker and external-URL acquisition contract regressed.\n' >&2
  exit 1
fi
if ! rg -F -x -q 'Version: 0.2.7' \
      "$marktheme_root/control" || \
   ! rg -F -x -q 'Depends: firmware (>= 17.0), uikittools, ellekit (>= 1.2)' \
      "$marktheme_root/control" || \
   ! rg -F -x -q 'TARGET := iphone:clang:latest:17.0' \
      "$marktheme_root/Config.mk" || \
   ! rg -F -x -q 'PACKAGE_VERSION ?= 0.2.7' \
      "$marktheme_root/Config.mk" || \
   ! rg -F -q '当前版本为 `v0.2.7`' \
      "$marktheme_root/README.md" || \
   ! rg -F -q 'The current version is `v0.2.7`.' \
      "$marktheme_root/README.en.md" || \
   ! rg -F -q '[主题混搭与功能开关](docs/THEME_MIXING.md)' \
      "$marktheme_root/README.md" || \
   ! rg -F -q '[Theme Mixing and Feature Switches](docs/THEME_MIXING.en.md)' \
      "$marktheme_root/README.en.md" || \
   ! rg -F -q '关闭不是仅隐藏预览' \
      "$marktheme_root/docs/THEME_MIXING.md" || \
   ! rg -F -q 'Disabling a feature is not a preview-only change' \
      "$marktheme_root/docs/THEME_MIXING.en.md" || \
   ! rg -F -x -q '简体中文 | [English](README.en.md)' \
      "$marktheme_root/README.md" || \
   ! rg -F -x -q '[简体中文](README.md) | English' \
      "$marktheme_root/README.en.md" || \
   ! rg -F -x -q 'MARKTHEME_RUNTIME_BUILD_NUMBER := 171' \
      "$marktheme_root/Config.mk" || \
   [[ $(plutil -extract CFBundleShortVersionString raw -o - \
        "$marktheme_root/app/Resources/Info.plist") != '0.2.7' || \
      $(plutil -extract CFBundleVersion raw -o - \
        "$marktheme_root/app/Resources/Info.plist") != '21' || \
      $(plutil -extract MinimumOSVersion raw -o - \
        "$marktheme_root/app/Resources/Info.plist") != '17.0' ]]; then
  printf 'FAIL: package, App, READMEs, and Runtime protocol versions are not pinned.\n' >&2
  exit 1
fi
if rg -F -q 'traitCollectionDidChange:' "$marktheme_root/app"; then
  printf 'FAIL: the iOS 17+ app retains a deprecated trait-change fallback.\n' >&2
  exit 1
fi
if ! rg -F -x -q \
      'MARKTHEME_PATH_CFLAGS := -DTHEOS_PACKAGE_SCHEME_ROOTHIDE=1' \
      "$marktheme_root/Config.mk" || \
   ! rg -F -x -q '    -DTHEOS_PACKAGE_SCHEME_ROOTLESS=1' \
      "$marktheme_root/Config.mk"; then
  printf 'FAIL: package builds do not declare their RootHide/rootless scheme.\n' >&2
  exit 1
fi
if ! rg -F -q 'spawnArguments[0] = executable == NULL ? NULL : strdup(executable);' \
      "$marktheme_root/store/MTRuntimeHelperClient.m" || \
   ! rg -F -q 'spawnArguments[index + 1] = value == NULL ? NULL : strdup(value);' \
      "$marktheme_root/store/MTRuntimeHelperClient.m" || \
   ! rg -F -q 'marktheme-helper invalid request (argc=%d, operation=%s,' \
      "$marktheme_root/helper/main.m"; then
  printf 'FAIL: M5-D.8 Helper argv ownership/diagnostics are incomplete.\n' >&2
  exit 1
fi
if ! rg -F -q 'MTThemePreviewRepository.m' \
      "$marktheme_root/app/Makefile" || \
   ! rg -F -q 'loadPreviewAssetDataForThemeID:' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
   ! rg -F -q 'MTSystemPreviewBundleImage' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
   ! rg -F -q '@"CFBundleIcons"' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
   ! rg -F -q 'LSApplicationProxy' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
   ! rg -F -q 'applicationProxyForIdentifier:' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
   ! rg -F -q 'sel_registerName("bundleURL")' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
   ! rg -F -q '@"/Applications/MobilePhone.app"' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
   ! rg -F -q 'imageNamed:name' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
   ! rg -F -q 'MTSystemPreviewFallbackImage' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
   rg -F -q 'MTSystemPreviewIconServicesImage' \
      "$marktheme_root/app/MTThemePreviewProvider.m" || \
