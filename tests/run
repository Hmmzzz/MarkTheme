if ! rg -F -x -q 'MARKTHEME_ICON_SERVICE_RUNTIME_MODE ?= 0' \
      "$icon_service_makefile" || \
   ! rg -F -x -q 'MARKTHEME_ICON_SERVICE_PROVEN_CANARY ?= 0' \
      "$icon_service_makefile" || \
   [[ $(plutil -extract Filter.Executables json -o - \
      "$icon_service_filter") != '["iconservicesagent"]' ]] || \
   rg -F -q 'SUBPROJECTS += iconservice' "$marktheme_root/Makefile"; then
  printf 'FAIL: the unshipped IconServices runtime is not default-disabled, exactly filtered, and outside the release aggregate.\n' >&2
  exit 1
fi
if rg -n \
    'UIKit|QuartzCore|SpringBoardHome|SearchUI|PreferencesApplicationIcon|ShareSheetActivityImage' \
    "$icon_service_makefile" \
    "$icon_service_dir" -g '*.{h,m,mm,c,cpp}'; then
  printf 'FAIL: a display-process or UIKit dependency escaped into the IconServices service runtime.\n' >&2
  exit 1
fi
for icon_service_contract in \
  'generateImageReturningRecordIdentifiers:' \
  '@24@0:8^@16' \
  '8B774C6D-D367-30BA-B31B-6F7A7344EDFD' \
  '5FA9A56A-94F2-39B1-8468-DD04574428E3' \
  'B68AA0B6-EFEA-3DCD-AF68-A034411947FD' \
  '0A08A069-61D7-3C2F-8274-AC0C2BA0651D' \
  'initWithCGImage:scale:minimumSize:placeholder:iconSize:' \
  'initWithData:uuid:validationToken:' \
  'CGSizeEqualToSize(left.pixelSize, right.pixelSize)' \
  'MTIconServiceStoreIndexValueByteCount = 0x74' \
  'performBlock:' \
  'removeValueForUUID:passingTest:' \
  'MTIconServiceDigestCoverageAuthoritative' \
  'requiresBroadFallback' \
  'MTRuntimePublishedImageResizePolicyBoundedScaleToFill' \
  'MTIconMaskCreateImage' \
  'MTIconOverlayCreateImage'; do
  rg -F -q "$icon_service_contract" "$icon_service_dir" \
      -g '*.{h,m,mm,c,cpp}' || {
    printf 'FAIL: IconServices runtime omits proven contract: %s\n' \
      "$icon_service_contract" >&2
    exit 1
  }
done
if [[ $(rg -F -c 'MSHookMessageEx(' \
      "$icon_service_dir/MTIconServiceGenerationAdapter.m") -ne 1 ]]; then
  printf 'FAIL: IconServices source runtime must contain exactly one pixel-generation Hook installation.\n' >&2
  exit 1
fi
if rg -F -q 'invalidateBundleIdentifiers:' \
      "$icon_service_dir/MTIconServiceBootstrap.m"; then
  printf 'FAIL: targeted StoreIndex mutation escaped ahead of the helper/service ordering barrier.\n' >&2
  exit 1
fi

printf 'PASS: MarkTheme M3-F.4 performance, M3-E targeted refresh, M3-D snapshot/cache, M3-C visual evidence, durability, lifecycle, Apply, Store, Helper, generation and resource boundaries\n'
