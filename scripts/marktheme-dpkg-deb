#!/usr/bin/env bash

set -euo pipefail

upstream_dm=${MARKTHEME_UPSTREAM_DM:-}
if [[ -z "$upstream_dm" && -n "${THEOS:-}" ]]; then
  upstream_dm="$THEOS/vendor/dm.pl/dm.pl"
fi
if [[ -z "$upstream_dm" ]]; then
  upstream_dm=$(command -v dm.pl || true)
fi

arguments=("$@")
staging_root=
for ((index = 0; index < ${#arguments[@]}; index++)); do
  if [[ "${arguments[$index]}" == "-b" && \
        $((index + 1)) -lt ${#arguments[@]} ]]; then
    staging_root=${arguments[$((index + 1))]}
    break
  fi
done

if [[ -z "$staging_root" || ! -d "$staging_root" ]]; then
  printf 'MarkTheme package staging root is missing.\n' >&2
  exit 66
fi

root_helper="$staging_root/usr/libexec/marktheme-helper"
rootless_helper="$staging_root/var/jb/usr/libexec/marktheme-helper"
if [[ -f "$root_helper" && ! -L "$root_helper" && \
      ! -e "$rootless_helper" ]]; then
  # RootHide maintenance scripts run in its vroot namespace. /rootfs is the
  # stable shell path to Manager data stored on the original iOS filesystem.
  package_prefix=
  rootfs_prefix=/rootfs
  helper="$root_helper"
elif [[ -f "$rootless_helper" && ! -L "$rootless_helper" && \
        ! -e "$root_helper" ]]; then
  package_prefix=/var/jb
  rootfs_prefix=
  helper="$rootless_helper"
else
  printf 'MarkTheme Helper is missing or is not a regular staged file.\n' >&2
  exit 66
fi

for lifecycle_name in prerm postrm; do
  lifecycle_script="$staging_root/DEBIAN/$lifecycle_name"
  if [[ ! -f "$lifecycle_script" || -L "$lifecycle_script" ]] || \
     ! /usr/bin/grep -q '@MARKTHEME_PACKAGE_PREFIX@' "$lifecycle_script"; then
    printf 'MarkTheme %s template is missing or already rendered.\n' \
      "$lifecycle_name" >&2
    exit 66
  fi

  rendered_script=$(mktemp "${lifecycle_script}.rendered.XXXXXX")
  /usr/bin/sed \
    -e "s|@MARKTHEME_PACKAGE_PREFIX@|$package_prefix|g" \
    -e "s|@MARKTHEME_ROOTFS_PREFIX@|$rootfs_prefix|g" \
    "$lifecycle_script" > "$rendered_script"
  /bin/chmod 0755 "$rendered_script"
  /bin/mv -f "$rendered_script" "$lifecycle_script"
done

if /usr/bin/grep -R -E -q \
    '@MARKTHEME_(PACKAGE|ROOTFS)_PREFIX@' "$staging_root"; then
  printf 'A MarkTheme lifecycle path placeholder remained after staging.\n' >&2
  exit 70
fi

/bin/chmod 4755 "$helper"
helper_mode=$(/usr/bin/stat -f '%Mp%Lp' "$helper")
if [[ "$helper_mode" != "4755" ]]; then
  printf 'Unable to stage marktheme-helper with mode 4755; found %s.\n' \
    "$helper_mode" >&2
  exit 77
fi

if [[ ! -x "$upstream_dm" ]]; then
  printf 'Theos dm.pl is unavailable. Set THEOS to the supported Theos root.\n' >&2
  exit 69
fi

exec "$upstream_dm" "$@"
