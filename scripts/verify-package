profile_manifest_digest=$(sed -n \
  's/.*"manifestDigest": "\([0-9a-f][0-9a-f]*\)".*/\1/p' \
  "$project_root/runtime/RuntimeProfiles.generated.json")
[[ ${#profile_manifest_digest} -eq 64 ]] || \
  fail 'generated Runtime profile digest is malformed'
generated_profile="$project_root/runtime/RuntimeProfiles.generated.json"
if rg -n \
    'osBuild|kern\.osversion|ExpectedImageUUID|[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}' \
    "$project_root/runtime" \
    "$project_root/scripts/generate-runtime-profiles" \
    -g '!**/.theos/**' -g '*.{h,m,json}' -g 'generate-runtime-profiles'; then
  fail 'Runtime compatibility contains an OS build or Mach-O UUID pin'
fi
profile_count=$(plutil -extract images.0.profiles raw -o - \
  "$generated_profile")
[[ "$profile_count" == '8' ]] || \
  fail 'generated Runtime profile count is not the exact eight-host composition'
profile_index_for_id() {
  local expected_profile_id=$1
  local profile_index
  local actual_profile_id
  for ((profile_index = 0; profile_index < profile_count; profile_index++)); do
    actual_profile_id=$(plutil -extract \
      "images.0.profiles.$profile_index.profileID" raw -o - \
      "$generated_profile")
    if [[ "$actual_profile_id" == "$expected_profile_id" ]]; then
      printf '%s' "$profile_index"
      return 0
    fi
  done
  return 1
}
mobilephone_profile_index=$(profile_index_for_id 'mobilephone.dialer') || \
  fail 'generated Runtime profile omits MobilePhone Dialer'
preferences_profile_index=$(profile_index_for_id 'preferences.ui-icons') || \
  fail 'generated Runtime profile omits Preferences'
share_sheet_profile_index=$(profile_index_for_id 'share-sheet.ui-icons') || \
  fail 'generated Runtime profile omits SharingUIService'
loaded_share_sheet_profile_index=$(profile_index_for_id 'share-sheet.loaded-host.ui-icons') || \
  fail 'generated Runtime profile omits loaded ShareSheet hosts'
photos_share_sheet_profile_index=$(profile_index_for_id 'photos.share-sheet.ui-icons') || \
  fail 'generated Runtime profile omits Photos in-process Share Sheet'
sharingd_profile_index=$(profile_index_for_id 'sharingd.share-sheet.ui-icons') || \
  fail 'generated Runtime profile omits sharingd'
spotlight_profile_index=$(profile_index_for_id 'spotlight.application-icons') || \
  fail 'generated Runtime profile omits Spotlight'
springboard_profile_index=$(profile_index_for_id 'springboard.icons') || \
  fail 'generated Runtime profile omits SpringBoard'

