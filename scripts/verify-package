prerm="$verify_dir/control/prerm"
postrm="$verify_dir/control/postrm"
for lifecycle_script in "$prerm" "$postrm"; do
  [[ -f "$lifecycle_script" && ! -L "$lifecycle_script" && \
     -x "$lifecycle_script" ]] || \
    fail 'a required package lifecycle script is missing or unsafe'
  /bin/sh -n "$lifecycle_script" || \
    fail 'a package lifecycle script is invalid'
done
[[ ! -e "$verify_dir/control/postinst" ]] || \
  fail 'MarkTheme unexpectedly contains a configure script'
for preserved_action in upgrade failed-upgrade deconfigure; do
  /bin/sh "$prerm" "$preserved_action" || \
    fail "prerm rejected preserved action: $preserved_action"
done
for preserved_action in upgrade failed-upgrade abort-install \
    abort-upgrade; do
  /bin/sh "$postrm" "$preserved_action" || \
    fail "postrm rejected preserved action: $preserved_action"
done

expected_prefix_line="package_prefix='$runtime_prefix'"
for lifecycle_script in "$prerm" "$postrm"; do
  rg -F -x -q "$expected_prefix_line" "$lifecycle_script" || \
    fail 'a lifecycle package prefix does not match the package scheme'
done
for lifecycle_literal in \
  'runtime_helper="${package_prefix}/usr/libexec/marktheme-helper"' \
  '"$runtime_helper" disable --json >/dev/null 2>&1 || true' \
  'remove)' \
  'upgrade|failed-upgrade|deconfigure)'; do
  rg -F -q "$lifecycle_literal" "$prerm" || \
    fail "prerm lifecycle contract is missing: $lifecycle_literal"
done
for lifecycle_literal in \
  "manager_data_root='/var/mobile/Library/Application Support/MarkTheme'" \
  'runtime_store_root="${package_prefix}/var/lib/marktheme"' \
  "preferences_file='/var/mobile/Library/Preferences/com.hmmzzz.marktheme.plist'" \
  'remove|purge|disappear)' \
  'upgrade|failed-upgrade|abort-install|abort-upgrade)' \
  'validate_exact_tree "$manager_data_root"' \
  'validate_exact_tree "$runtime_store_root"' \
  'validate_exact_file "$preferences_file"' \
  'remove_exact_tree "$manager_data_root"' \
  'remove_exact_tree "$runtime_store_root"' \
  'remove_exact_file "$preferences_file"'; do
  rg -F -q "$lifecycle_literal" "$postrm" || \
    fail "postrm lifecycle contract is missing: $lifecycle_literal"
done
if rg -n \
    'sbreload|ldrestart|reboot|launchctl|killall|finish:reload|/private/preboot/' \
    "$prerm" "$postrm"; then
  fail 'MarkTheme package lifecycle performs a restart or physical-path action'
fi
if rg -F -q '@MARKTHEME_PACKAGE_PREFIX@' "$verify_dir/control"; then
  fail 'an unrendered package-prefix placeholder escaped into package control data'
fi

if rg -a -n '/private/preboot/' "$verify_dir/control" "$verify_dir/data" >/dev/null; then
  fail 'a randomized/bootstrap physical path escaped into the package'
fi
if [[ "$package_scheme" == roothide ]] && \
   rg -a -n '/var/jb' "$verify_dir/control" "$verify_dir/data" >/dev/null; then
  fail 'RootHide package embeds a conventional rootless /var/jb path'
fi

package_sha256=$(/usr/bin/shasum -a 256 "$deb_path" | awk '{ print $1 }')
printf 'Verified MarkTheme %s package: %s\n' "$package_scheme" "$deb_path"
printf '  SHA-256:       %s\n' "$package_sha256"
printf '  version:       %s\n' "$package_version"
printf '  architecture:  %s\n' "$package_arch"
printf '  Mach-O slices: arm64 arm64e\n'
printf '  minimum iOS:   17.0\n'
printf '  display:       %s-byte native-invalidation/live-category Runtime for exact SpringBoard/Preferences/Share/Spotlight/MobilePhone hosts\n' \
  "$runtime_byte_count"
printf '  icon source:   %s-byte exact iconservicesagent source with verified native whole-cache clearing\n' \
  "$icon_service_runtime_byte_count"
printf '  payload:       Manager + short-lived root Helper + two scoped Runtimes; no daemon\n'
