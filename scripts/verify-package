#!/usr/bin/env bash

set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

if [[ $# -ne 1 ]]; then
  printf 'Usage: %s <marktheme.deb>\n' "$0" >&2
  exit 64
fi

deb_input=$1
if [[ ! -f "$deb_input" ]]; then
  printf 'Package does not exist: %s\n' "$deb_input" >&2
  exit 66
fi

"$script_dir/generate-runtime-profiles" --check

deb_dir=$(CDPATH= cd -- "$(dirname -- "$deb_input")" && pwd)
deb_path="$deb_dir/$(basename -- "$deb_input")"
verify_dir=$(mktemp -d /tmp/marktheme-package-verify.XXXXXX)

cleanup() {
  if [[ "$verify_dir" == /tmp/marktheme-package-verify.* && \
        -d "$verify_dir" ]]; then
    find "$verify_dir" -depth -delete
  fi
}
trap cleanup EXIT INT TERM

fail() {
  printf 'MarkTheme package verification failed: %s\n' "$1" >&2
  exit 65
}

archive_record() {
  local archive=$1
  local name=$2
  /usr/bin/tar -tvf "$archive" | \
    awk -v name="$name" '$NF == name || $NF == "./" name { print; exit }'
}

mkdir -p "$verify_dir/ar" "$verify_dir/control" "$verify_dir/data"
(cd "$verify_dir/ar" && /usr/bin/ar -x "$deb_path")

control_archive=$(find "$verify_dir/ar" -maxdepth 1 -type f \
  -name 'control.tar*' -print | head -n 1)
data_archive=$(find "$verify_dir/ar" -maxdepth 1 -type f \
  -name 'data.tar*' -print | head -n 1)
[[ -n "$control_archive" && -n "$data_archive" ]] || \
  fail 'control/data archive member is missing'

/usr/bin/tar -xf "$control_archive" -C "$verify_dir/control"
/usr/bin/tar -xf "$data_archive" -C "$verify_dir/data"

control_file="$verify_dir/control/control"
[[ -f "$control_file" && ! -L "$control_file" ]] || \
  fail 'control metadata is missing or unsafe'

control_value() {
  local key=$1
  awk -F ': ' -v key="$key" 'tolower($1) == tolower(key) { print $2; exit }' \
    "$control_file"
}

package_id=$(control_value Package)
package_name=$(control_value Name)
package_version=$(control_value Version)
package_arch=$(control_value Architecture)
package_depends=$(control_value Depends)
package_section=$(control_value Section)
package_homepage=$(control_value Homepage)
package_icon=$(control_value Icon)
package_depiction=$(control_value Depiction)
package_sileo_depiction=$(control_value SileoDepiction)

[[ "$package_id" == 'com.hmmzzz.marktheme' ]] || fail 'package ID is incorrect'
[[ "$package_name" == 'MarkTheme' ]] || fail 'package name is incorrect'
[[ "$package_version" == '0.2.7' ]] || \
  fail 'package version is not the pinned release version'
[[ "$package_section" == 'Utilities' && \
   "$package_homepage" == 'https://github.com/Hmmzzz/MarkTheme' && \
   "$package_icon" == \
     'https://hmmzzz.github.io/repo/depictions/marktheme/icon.png' && \
   "$package_depiction" == \
     'https://hmmzzz.github.io/repo/depictions/marktheme/' && \
   "$package_sileo_depiction" == \
     'https://hmmzzz.github.io/repo/depictions/marktheme/sileo.json' ]] || \
  fail 'package release links or section are malformed'
[[ "$package_depends" == *'firmware (>= 17.0)'* && \
   "$package_depends" == *'uikittools'* && \
   "$package_depends" == *'ellekit (>= 1.2)'* ]] || \
  fail 'minimum firmware, app registration, or ElleKit dependency is missing'
if [[ "$package_depends" == *'mobilesubstrate'* || \
      "$package_depends" == *'preferenceloader'* ]]; then
  fail 'an unapproved injection or preferences dependency escaped into the package'
fi
rg -F -q \
  'Description: 适用于现代 iOS 越狱环境的模块化主题引擎与管理器。' \
  "$control_file" || fail 'package description is missing or malformed'
for release_detail in \
  'MarkTheme 0.2.7 支持导入 SnowBoard / IconBundles 风格主题' \
  '支持跨主题混搭和功能独立开关' \
  '按提示 Respring 即可应用新外观' \
  '提供 conventional rootless 与 RootHide 独立软件包，支持 iOS 17.0 至 18.x' \
  '两个版本不可混装'; do
  rg -F -q "$release_detail" "$control_file" || \
    fail "package release description is incomplete: $release_detail"
done

case "$package_arch" in
  iphoneos-arm64e)
    package_scheme=roothide
    runtime_prefix=
    ;;
  iphoneos-arm64)
    package_scheme=rootless
    runtime_prefix=/var/jb
    ;;
  *)
    fail "unsupported package architecture: $package_arch"
    ;;
esac

data_root="$verify_dir/data$runtime_prefix"
[[ -d "$data_root" && ! -L "$data_root" ]] || \
  fail 'scheme data root is missing or unsafe'
if [[ "$package_scheme" == rootless ]]; then
  unexpected_top=$(find "$verify_dir/data" -mindepth 1 -maxdepth 1 \
    ! -name var -print -quit)
  [[ -z "$unexpected_top" ]] || fail 'rootless payload escaped /var/jb'
  unexpected_var=$(find "$verify_dir/data/var" -mindepth 1 -maxdepth 1 \
    ! -name jb -print -quit)
  [[ -z "$unexpected_var" ]] || fail 'rootless payload escaped /var/jb'
else
  [[ ! -e "$verify_dir/data/var/jb" ]] || \
    fail 'RootHide payload unexpectedly contains /var/jb'
fi

unexpected_payload=$(find "$data_root" -mindepth 1 -maxdepth 1 \
  ! -name Applications ! -name Library ! -name usr -print -quit)
[[ -z "$unexpected_payload" ]] || \
  fail 'M3-E payload contains an undeclared top-level component'

unexpected_usr=$(find "$data_root/usr" -mindepth 1 -maxdepth 1 \
  ! -name libexec -print -quit)
[[ -z "$unexpected_usr" ]] || fail 'Helper payload escaped usr/libexec'

app="$data_root/Applications/MarkTheme.app"
binary="$app/MarkTheme"
info="$app/Info.plist"
helper="$data_root/usr/libexec/marktheme-helper"
runtime_dir="$data_root/Library/MobileSubstrate/DynamicLibraries"
runtime="$runtime_dir/MarkThemeRuntime.dylib"
runtime_filter="$runtime_dir/MarkThemeRuntime.plist"
icon_service_runtime="$runtime_dir/MarkThemeIconServiceRuntime.dylib"
icon_service_filter="$runtime_dir/MarkThemeIconServiceRuntime.plist"
[[ -d "$app" && ! -L "$app" && -f "$binary" && ! -L "$binary" ]] || \
  fail 'MarkTheme application or executable is missing'
[[ -f "$info" && ! -L "$info" ]] || fail 'application Info.plist is missing'
for app_icon in \
  AppIcon20x20@2x.png \
  AppIcon20x20@3x.png \
  AppIcon29x29@2x.png \
  AppIcon29x29@3x.png \
  AppIcon40x40@2x.png \
  AppIcon40x40@3x.png \
  AppIcon60x60@2x.png \
  AppIcon60x60@3x.png \
  AppIcon1024x1024.png; do
  [[ -f "$app/$app_icon" && ! -L "$app/$app_icon" ]] || \
    fail "application icon resource is missing: $app_icon"
done
[[ -f "$helper" && ! -L "$helper" ]] || \
  fail 'MarkTheme fixed-operation Helper is missing'
[[ -d "$runtime_dir" && ! -L "$runtime_dir" && \
   -f "$runtime" && ! -L "$runtime" && \
   -f "$runtime_filter" && ! -L "$runtime_filter" && \
   -f "$icon_service_runtime" && ! -L "$icon_service_runtime" && \
   -f "$icon_service_filter" && ! -L "$icon_service_filter" ]] || \
  fail 'a product Runtime image or exact filter is missing'
unexpected_library=$(find "$data_root/Library" -mindepth 1 -maxdepth 1 \
  ! -name MobileSubstrate -print -quit)
[[ -z "$unexpected_library" ]] || \
  fail 'Runtime payload escaped Library/MobileSubstrate'
unexpected_substrate=$(find "$data_root/Library/MobileSubstrate" \
  -mindepth 1 -maxdepth 1 ! -name DynamicLibraries -print -quit)
[[ -z "$unexpected_substrate" ]] || \
  fail 'Runtime payload escaped the DynamicLibraries directory'
unexpected_runtime=$(find "$runtime_dir" -mindepth 1 -maxdepth 1 \
  ! -name MarkThemeRuntime.dylib ! -name MarkThemeRuntime.plist \
  ! -name MarkThemeIconServiceRuntime.dylib \
  ! -name MarkThemeIconServiceRuntime.plist -print -quit)
[[ -z "$unexpected_runtime" ]] || \
  fail 'an undeclared Runtime file was packaged'
[[ $(find "$data_root" -type f -name '*.dylib' | wc -l | tr -d ' ') -eq 2 && \
   $(find "$data_root" -type f -name '*.plist' -path '*DynamicLibraries*' | \
     wc -l | tr -d ' ') -eq 2 ]] || \
  fail 'the package must contain exactly the display Runtime and IconServices source Runtime pairs'
if find "$data_root" -type f \( -name '*.x' -o -name '*.xm' \) \
    -print | rg -q .; then
  fail 'Runtime source escaped into the product package'
fi
cmp -s "$runtime_filter" "$project_root/runtime/MarkThemeRuntime.plist" || \
  fail 'packaged Runtime filter differs from the generated profile source'
cmp -s "$icon_service_filter" \
  "$project_root/iconservice/MarkThemeIconServiceRuntime.plist" || \
  fail 'packaged IconServices filter differs from its exact source'
[[ $(plutil -extract Filter.Bundles json -o - "$runtime_filter") == \
      '["com.apple.Preferences","com.apple.ShareSheet","com.apple.SharingUIService","com.apple.Spotlight","com.apple.mobilephone","com.apple.mobileslideshow","com.apple.sharingd","com.apple.springboard"]' ]] || \
  fail 'Runtime filter is not the exact generated eight-host allowlist'
[[ $(plutil -extract Filter.Executables json -o - \
      "$icon_service_filter") == '["iconservicesagent"]' ]] || \
  fail 'IconServices source filter is not the exact iconservicesagent allowlist'

for executable in "$binary" "$helper" "$runtime" "$icon_service_runtime"; do
  executable_arches=" $(xcrun lipo -archs "$executable") "
  [[ "$executable_arches" == *' arm64 '* && \
     "$executable_arches" == *' arm64e '* ]] || \
    fail "executable is not arm64+arm64e: $executable"
  minos_count=$(xcrun vtool -show-build "$executable" | \
    rg -c '^    minos 17\.0$' || true)
  [[ "$minos_count" -eq 2 ]] || \
    fail "executable does not declare iOS 17.0 on both slices: $executable"
done

runtime_byte_count=$(stat -f '%z' "$runtime")
icon_service_runtime_byte_count=$(stat -f '%z' "$icon_service_runtime")
# Adding one independently ABI-gated SpringBoard adapter can advance the
# signed arm64e __LINKEDIT segment by one 16 KiB Mach-O page even when its
# live code is much smaller. Keep the ceiling explicit and page-bounded.
# The icon-overlay ModuleRuntime added four such pages to this symbolized image,
# and the pre-rounded square morph carrier resolver added a sixth.
[[ "$runtime_byte_count" -le 2195456 ]] || \
  fail 'the symbolized Runtime image exceeds the M3-E 2 MiB plus one Mach-O page composition budget'
[[ "$icon_service_runtime_byte_count" -le 1048576 ]] || \
  fail 'the symbolized IconServices source Runtime exceeds its 1 MiB service budget'

linked_libraries=$(xcrun otool -L "$binary")
load_commands=$(xcrun otool -l "$binary")
helper_linked_libraries=$(xcrun otool -L "$helper")
helper_load_commands=$(xcrun otool -l "$helper")
runtime_linked_libraries=$(xcrun otool -L "$runtime")
runtime_load_commands=$(xcrun otool -l "$runtime")
runtime_install_name=$(xcrun otool -D "$runtime")
icon_service_linked_libraries=$(xcrun otool -L "$icon_service_runtime")
icon_service_load_commands=$(xcrun otool -l "$icon_service_runtime")
icon_service_install_name=$(xcrun otool -D "$icon_service_runtime")
if [[ "$package_scheme" == roothide ]]; then
  rg -q '@loader_path/\.jbroot/usr/lib/libroothide\.dylib' \
    <<<"$linked_libraries" || \
    fail 'RootHide Manager library install name is missing'
  rg -q '@loader_path/\.jbroot/usr/lib/libroothide\.dylib' \
    <<<"$helper_linked_libraries" || \
    fail 'RootHide Helper library install name is missing'
  rg -q '@loader_path/\.jbroot/usr/lib/libroothide\.dylib' \
    <<<"$runtime_linked_libraries" || \
    fail 'RootHide Runtime library install name is missing'
  rg -q '@loader_path/\.jbroot/usr/lib/libsubstrate\.dylib' \
    <<<"$runtime_linked_libraries" || \
    fail 'RootHide Runtime is missing the ElleKit substrate-compatibility link'
  rg -q '@loader_path/\.jbroot/usr/lib/libroothide\.dylib' \
    <<<"$icon_service_linked_libraries" || \
    fail 'RootHide IconServices source library install name is missing'
  rg -q '@loader_path/\.jbroot/usr/lib/libsubstrate\.dylib' \
    <<<"$icon_service_linked_libraries" || \
    fail 'RootHide IconServices source is missing the Hook backend link'
  ! rg -q '@rpath/CydiaSubstrate\.framework/CydiaSubstrate' \
    <<<"$runtime_linked_libraries" || \
    fail 'RootHide Runtime retained the conventional rootless Hook install name'
  ! rg -q '@rpath/CydiaSubstrate\.framework/CydiaSubstrate' \
    <<<"$icon_service_linked_libraries" || \
    fail 'RootHide IconServices source retained the rootless Hook install name'
  rg -q '^@loader_path/\.jbroot/Library/MobileSubstrate/DynamicLibraries/MarkThemeRuntime\.dylib$' \
    <<<"$runtime_install_name" || \
    fail 'RootHide Runtime dylib install name is not bootstrap-relocatable'
  rg -q '^@loader_path/\.jbroot/Library/MobileSubstrate/DynamicLibraries/MarkThemeIconServiceRuntime\.dylib$' \
    <<<"$icon_service_install_name" || \
    fail 'RootHide IconServices source install name is not bootstrap-relocatable'
else
  ! rg -q 'libroothide\.dylib' <<<"$linked_libraries" || \
    fail 'rootless Manager links the RootHide-only library'
  ! rg -q 'libroothide\.dylib' <<<"$helper_linked_libraries" || \
    fail 'rootless Helper links the RootHide-only library'
  ! rg -q 'libroothide\.dylib' <<<"$runtime_linked_libraries" || \
    fail 'rootless Runtime links the RootHide-only library'
  ! rg -q 'libroothide\.dylib' <<<"$icon_service_linked_libraries" || \
    fail 'rootless IconServices source links the RootHide-only library'
  rg -q 'path /var/jb/usr/lib ' <<<"$load_commands" || \
    fail 'rootless /var/jb library rpath is missing'
  rg -q 'path @loader_path/\.jbroot/usr/lib ' <<<"$load_commands" || \
    fail 'relocatable rootless library rpath is missing'
  rg -q 'path /var/jb/usr/lib ' <<<"$helper_load_commands" || \
    fail 'rootless Helper /var/jb library rpath is missing'
  rg -q 'path @loader_path/\.jbroot/usr/lib ' <<<"$helper_load_commands" || \
    fail 'relocatable rootless Helper library rpath is missing'
  rg -q '^@rpath/MarkThemeRuntime\.dylib$' \
    <<<"$runtime_install_name" || \
    fail 'rootless Runtime dylib install name is not relocatable'
  rg -q '^@rpath/MarkThemeIconServiceRuntime\.dylib$' \
    <<<"$icon_service_install_name" || \
    fail 'rootless IconServices source dylib install name is not relocatable'
  rg -q 'path /var/jb/usr/lib ' <<<"$runtime_load_commands" || \
    fail 'rootless Runtime /var/jb library rpath is missing'
  rg -q 'path @loader_path/\.jbroot/usr/lib ' <<<"$runtime_load_commands" || \
    fail 'relocatable rootless Runtime library rpath is missing'
  rg -q 'path /var/jb/Library/Frameworks ' <<<"$runtime_load_commands" || \
    fail 'rootless Runtime Hook framework rpath is missing'
  rg -q 'path @loader_path/\.jbroot/Library/Frameworks ' \
    <<<"$runtime_load_commands" || \
    fail 'relocatable rootless Runtime Hook framework rpath is missing'
  rg -q '@rpath/CydiaSubstrate\.framework/CydiaSubstrate' \
    <<<"$runtime_linked_libraries" || \
    fail 'rootless Runtime is missing the ElleKit substrate-compatibility link'
  rg -q 'path /var/jb/usr/lib ' <<<"$icon_service_load_commands" || \
    fail 'rootless IconServices source /var/jb library rpath is missing'
  rg -q 'path @loader_path/\.jbroot/usr/lib ' \
    <<<"$icon_service_load_commands" || \
    fail 'relocatable IconServices source library rpath is missing'
  rg -q 'path /var/jb/Library/Frameworks ' \
    <<<"$icon_service_load_commands" || \
    fail 'rootless IconServices source Hook framework rpath is missing'
  rg -q 'path @loader_path/\.jbroot/Library/Frameworks ' \
    <<<"$icon_service_load_commands" || \
    fail 'relocatable IconServices source Hook framework rpath is missing'
  rg -q '@rpath/CydiaSubstrate\.framework/CydiaSubstrate' \
    <<<"$icon_service_linked_libraries" || \
    fail 'rootless IconServices source is missing the Hook backend link'
  ! rg -q 'libsubstrate\.dylib' <<<"$runtime_linked_libraries" || \
    fail 'rootless Runtime retained a RootHide Hook install name'
  ! rg -q 'libsubstrate\.dylib' <<<"$icon_service_linked_libraries" || \
    fail 'rootless IconServices source retained a RootHide Hook install name'
fi
if rg -q 'ElleKit|libhooker|substitute' \
    <<<"$runtime_linked_libraries $icon_service_linked_libraries"; then
  fail 'an undeclared second Hook backend escaped into the M3-E Runtime'
fi
rg -q '/System/Library/Frameworks/UIKit\.framework/UIKit' \
  <<<"$runtime_linked_libraries" || \
  fail 'the M3-E snapshot ModuleRuntime is missing UIKit linkage'
rg -q '/System/Library/Frameworks/CoreGraphics\.framework/CoreGraphics' \
  <<<"$runtime_linked_libraries" || \
  fail 'the M3-E snapshot ModuleRuntime is missing CoreGraphics linkage'
rg -q '/System/Library/Frameworks/ImageIO\.framework/ImageIO' \
  <<<"$runtime_linked_libraries" || \
  fail 'the M3-E snapshot ModuleRuntime is missing ImageIO linkage'
rg -q '/System/Library/Frameworks/QuartzCore\.framework/QuartzCore' \
  <<<"$runtime_linked_libraries" || \
  fail 'the M5-H Icon Shadow ModuleRuntime is missing QuartzCore linkage'
rg -q '/System/Library/Frameworks/CoreGraphics\.framework/CoreGraphics' \
  <<<"$icon_service_linked_libraries" || \
  fail 'IconServices source is missing CoreGraphics linkage'
rg -q '/System/Library/Frameworks/ImageIO\.framework/ImageIO' \
  <<<"$icon_service_linked_libraries" || \
  fail 'IconServices source is missing ImageIO linkage'
if rg -q '/System/Library/Frameworks/UIKit\.framework/UIKit' \
    <<<"$icon_service_linked_libraries"; then
  fail 'IconServices source must remain independent of UIKit display layers'
fi

for runtime_arch in arm64 arm64e; do
  runtime_arch_load_commands=$(xcrun otool -l -arch "$runtime_arch" "$runtime")
  runtime_init_size=$(awk '
    $1 == "sectname" && $2 == "__init_offsets" { found = 1; next }
    found && $1 == "size" { print $2; exit }
  ' <<<"$runtime_arch_load_commands")
  [[ "$runtime_init_size" == '0x0000000000000004' ]] || \
    fail "Runtime $runtime_arch does not contain exactly one bootstrap constructor"
  if rg -q '__objc_nlclslist|__objc_nlcatlist' \
      <<<"$runtime_arch_load_commands"; then
    fail "Runtime $runtime_arch contains an Objective-C +load entry point"
  fi
done
for icon_service_arch in arm64 arm64e; do
  icon_service_arch_load_commands=$(xcrun otool -l \
    -arch "$icon_service_arch" "$icon_service_runtime")
  icon_service_init_size=$(awk '
    $1 == "sectname" && $2 == "__init_offsets" { found = 1; next }
    found && $1 == "size" { print $2; exit }
  ' <<<"$icon_service_arch_load_commands")
  [[ "$icon_service_init_size" == '0x0000000000000004' ]] || \
    fail "IconServices source $icon_service_arch does not contain exactly one bootstrap constructor"
  if rg -q '__objc_nlclslist|__objc_nlcatlist' \
      <<<"$icon_service_arch_load_commands"; then
    fail "IconServices source $icon_service_arch contains an Objective-C +load entry point"
  fi
done

[[ $(plutil -extract CFBundleIdentifier raw -o - "$info") == \
      'com.hmmzzz.marktheme' && \
   $(plutil -extract CFBundleExecutable raw -o - "$info") == 'MarkTheme' && \
   $(plutil -extract CFBundleShortVersionString raw -o - "$info") == '0.2.7' && \
   $(plutil -extract CFBundleVersion raw -o - "$info") == '21' && \
   $(plutil -extract MinimumOSVersion raw -o - "$info") == '17.0' ]] || \
  fail 'application identity, version, or minimum iOS is malformed'
[[ $(plutil -extract CFBundleIconFiles json -o - "$info") == \
      '["AppIcon20x20","AppIcon29x29","AppIcon40x40","AppIcon60x60"]' && \
   $(plutil -extract \
      CFBundleIcons.CFBundlePrimaryIcon.CFBundleIconFiles json -o - "$info") == \
      '["AppIcon20x20","AppIcon29x29","AppIcon40x40","AppIcon60x60"]' && \
   $(plutil -extract \
      CFBundleIcons.CFBundlePrimaryIcon.UIPrerenderedIcon raw -o - "$info") == \
      'true' ]] || fail 'application icon declaration is malformed'
[[ -f "$app/zh-Hans.lproj/Localizable.strings" && \
   -f "$app/en.lproj/Localizable.strings" ]] || \
  fail 'application localizations are missing'

entitlements_output=$(ldid -e "$binary")
# ldid emits one entitlement plist per slice for this fat executable. Require
# the same minimal four-key contract on both arm64 and arm64e rather than
# parsing only the first plist or treating dotted entitlement names as a
# plutil key path. MobileDocuments is the exact grant the document picker
# needs to read an iCloud Drive selection; it is scoped to
# /var/mobile/Library/Mobile Documents and is only reachable through a
# user-selected, security-scoped URL.
[[ $(rg -c '<key>application-identifier</key>' \
      <<<"$entitlements_output") -eq 2 && \
   $(rg -c '<string>com.hmmzzz.marktheme</string>' \
      <<<"$entitlements_output") -eq 2 && \
   $(rg -c '<key>platform-application</key>' \
      <<<"$entitlements_output") -eq 2 && \
   $(rg -c '<key>com.apple.private.security.no-sandbox</key>' \
      <<<"$entitlements_output") -eq 2 && \
   $(rg -c '<key>com.apple.private.security.storage.MobileDocuments</key>' \
      <<<"$entitlements_output") -eq 2 && \
   $(rg -c '<key>' <<<"$entitlements_output") -eq 8 ]] || \
  fail 'both slices must contain exactly the four minimum app entitlements'
if rg -q \
    'bindfs-allow|AppDataContainers|get-task-allow|task_for_pid|dynamic-codesigning' \
    <<<"$entitlements_output"; then
  fail 'an unnecessary high-risk entitlement escaped into the Manager app'
fi

helper_entitlements=$(ldid -e "$helper")
[[ $(rg -c '<key>platform-application</key>' \
      <<<"$helper_entitlements") -eq 2 && \
   $(rg -c '<key>com.apple.private.security.no-sandbox</key>' \
      <<<"$helper_entitlements") -eq 2 ]] || \
  fail 'both Helper slices must contain the two required entitlements'
if rg -q \
    'application-identifier|bindfs-allow|AppDataContainers|MobileDocuments|get-task-allow|task_for_pid|dynamic-codesigning' \
    <<<"$helper_entitlements"; then
  fail 'an unnecessary entitlement escaped into the Runtime Helper'
fi

for injected_runtime in "$runtime" "$icon_service_runtime"; do
  runtime_entitlements=$(ldid -e "$injected_runtime")
  [[ -z "$runtime_entitlements" ]] || \
    fail 'an injected Runtime dylib carries executable entitlements'
done

if [[ -n "$runtime_prefix" ]]; then
  helper_archive_name="${runtime_prefix#/}/usr/libexec/marktheme-helper"
else
  helper_archive_name='usr/libexec/marktheme-helper'
fi
helper_record=$(archive_record "$data_archive" "$helper_archive_name")
[[ $(awk '{ print $1 }' <<<"$helper_record") == '-rwsr-xr-x' && \
   "$helper_record" =~ [[:space:]]root[[:space:]]+wheel[[:space:]] ]] || \
  fail 'marktheme-helper is not archived root:wheel mode 4755'

if [[ -n "$runtime_prefix" ]]; then
  runtime_archive_root="${runtime_prefix#/}/Library/MobileSubstrate/DynamicLibraries"
else
  runtime_archive_root='Library/MobileSubstrate/DynamicLibraries'
fi
runtime_record=$(archive_record "$data_archive" \
  "$runtime_archive_root/MarkThemeRuntime.dylib")
filter_record=$(archive_record "$data_archive" \
  "$runtime_archive_root/MarkThemeRuntime.plist")
icon_service_record=$(archive_record "$data_archive" \
  "$runtime_archive_root/MarkThemeIconServiceRuntime.dylib")
icon_service_filter_record=$(archive_record "$data_archive" \
  "$runtime_archive_root/MarkThemeIconServiceRuntime.plist")
[[ $(awk '{ print $1 }' <<<"$runtime_record") == '-rwxr-xr-x' && \
   "$runtime_record" =~ [[:space:]]root[[:space:]]+wheel[[:space:]] && \
   $(awk '{ print $1 }' <<<"$filter_record") == '-rw-r--r--' && \
   "$filter_record" =~ [[:space:]]root[[:space:]]+wheel[[:space:]] && \
   $(awk '{ print $1 }' <<<"$icon_service_record") == '-rwxr-xr-x' && \
   "$icon_service_record" =~ [[:space:]]root[[:space:]]+wheel[[:space:]] && \
   $(awk '{ print $1 }' <<<"$icon_service_filter_record") == '-rw-r--r--' && \
   "$icon_service_filter_record" =~ [[:space:]]root[[:space:]]+wheel[[:space:]] ]] || \
  fail 'Runtime image/filter archive ownership or mode is incorrect'

