"import.library.title" = "Formal Library revision";
"import.library.detail.format" = "A nonblocking per-theme lock admits the exact manifest digest set, reserves the complete revision plus %@, adopts each asset through APFS clone or streaming fallback with independent source/destination hashes, recovers canonical crash residue, then atomically switches current.json. Full reads checksum-walk the exact tree.";
