"import.audited.title" = "Unified audited source";
"import.audited.detail" = "Folders and archives expose only inventory-admitted files. Metadata and assets share chunked revalidation of node type, exact size, and SHA-256.";
"import.staging.title" = "Content-addressed asset staging";
"import.staging.detail" = "Audited bytes stream directly into a random 0600 partial, the destination is reopened and size/SHA-256 verified, then RENAME_EXCL publishes a digest object. Duplicate content deduplicates; any failure rolls back the complete 0700 session.";
"import.plist.title" = "Safe plist and display metadata";
"import.plist.detail.format" = "XML/binary · %@ input · %lu levels · %lu nodes · %lu entries per collection. The root Info.plist now reaches NFC immutable rebuilding and the CoreFoundation bundle display profile through the audited source.";
"import.image.title" = "Static PNG metadata gate";
"import.image.detail" = "PNG chunk bounds, ordering, and CRC are checked before non-caching ImageIO properties cross-check type, one frame, dimensions, alpha, and complete status. No CGImage, UIImage, or pixel buffer is created.";
"import.decode.title" = "Strict pixel decode and bounded preview";
"import.decode.detail.format" = "Full decode: up to %u px per side · %@ pixels · %@ row storage. Only a top-left sRGB premultiplied RGBA8 preview up to %u px / %@ is retained, with a pixel SHA-256.";
