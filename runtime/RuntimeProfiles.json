{
  "schemaVersion": 2,
  "images": [
    {
      "imageID": "runtime.system-ui",
      "binaryName": "MarkTheme64eRuntime",
      "profiles": [
        {
          "profileID": "mobilephone.dialer",
          "mode": "processAdapters",
          "bundleID": "com.apple.mobilephone",
          "executable": "MobilePhone",
          "adapters": [
            "mobilephone.dialer-buttons"
          ],
          "modules": [
            "dialer.snapshot"
          ]
        },
        {
          "profileID": "springboard.icons",
          "mode": "processAdapters",
          "bundleID": "com.apple.springboard",
          "executable": "SpringBoard",
          "adapters": [
            "springboard.icon-image-cache",
            "springboard.clock-image-set",
            "springboard.folder-image",
            "springboard.badge-background",
            "springboard.icon-shadow",
            "springboard.statusbar-signal-image"
          ],
          "modules": [
            "static-icons.snapshot",
            "calendar-icons.composite",
            "clock-icons.snapshot",
            "icon-mask.snapshot",
            "folder-icons.snapshot",
            "badges.snapshot",
            "icon-shadow.snapshot",
            "statusbar.snapshot"
          ]
        },
        {
          "profileID": "preferences.ui-icons",
          "mode": "processAdapters",
          "bundleID": "com.apple.Preferences",
          "executable": "Preferences",
          "adapters": [
            "preferences.icon-image-cache"
          ],
          "modules": [
            "ui-resources.snapshot"
          ]
        },
        {
          "profileID": "share-sheet.ui-icons",
          "mode": "processAdapters",
          "bundleID": "com.apple.SharingUIService",
          "executable": "SharingUIService",
          "adapters": [
            "share-sheet.activity-image"
          ],
          "modules": [
            "static-icons.snapshot",
            "icon-mask.snapshot",
            "ui-resources.snapshot"
          ]
        },
        {
          "profileID": "ui-kit.share-ui-icons",
          "mode": "processAdapters",
          "bundleID": "com.apple.UIKit.ShareUI",
          "executable": "com.apple.UIKit.ShareUI",
          "adapters": [
            "share-sheet.activity-image"
          ],
          "modules": [
            "static-icons.snapshot",
            "icon-mask.snapshot",
            "ui-resources.snapshot"
          ]
        },
        {
          "profileID": "sharingd.share-sheet.ui-icons",
          "mode": "processAdapters",
          "bundleID": "com.apple.sharingd",
          "executable": "sharingd",
          "adapters": [
            "share-sheet.activity-image"
          ],
          "modules": [
            "static-icons.snapshot",
            "icon-mask.snapshot",
            "ui-resources.snapshot"
          ]
        },
        {
          "profileID": "photos.share-sheet.ui-icons",
          "mode": "processAdapters",
          "bundleID": "com.apple.mobileslideshow",
          "executable": "MobileSlideShow",
          "adapters": [
            "share-sheet.activity-image"
          ],
          "modules": [
            "static-icons.snapshot",
            "icon-mask.snapshot",
            "ui-resources.snapshot"
          ]
        },
        {
          "profileID": "spotlight.application-icons",
          "mode": "processAdapters",
          "bundleID": "com.apple.Spotlight",
          "executable": "Spotlight",
          "adapters": [
            "spotlight.icon-image-cache",
            "springboard.clock-image-set",
            "spotlight.search-ui-app-image"
          ],
          "modules": [
            "static-icons.snapshot",
            "calendar-icons.composite",
            "clock-icons.snapshot",
            "icon-mask.snapshot"
          ]
        }
      ]
    }
  ]
}
